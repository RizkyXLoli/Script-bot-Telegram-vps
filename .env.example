# Salin jadi .env lalu isi:
# cp .env.example .env

# Telegram (wajib untuk TG, kosongkan kalau WA saja)
# Dapat dari @BotFather
BOT_TOKEN=

# Nomor WA owner untuk pairing code (format: 6281234567890, tanpa +)
OWNER_NUMBER=

# WhatsApp via Baileys (nonaktif default; aktifkan dengan WA_ENABLED=1)
# WA_LOGIN=qr (scan QR di log) atau pair (kode 8 digit ke nomor di bawah)
WA_ENABLED=0
WA_LOGIN=qr
WA_PAIR_NUMBER=
WA_SESSION_DIR=./db/wa-session

# ID owner untuk /owner (mis. wa:6281234567890@s.whatsapp.net atau tg:123456)
OWNER_ID=

# Prefix perintah (default /)
PREFIX=/

# Jumlah riwayat chat disimpan per user
MAX_HISTORY=20

# Folder database SQLite
DB_PATH=./db/bot.sqlite3

# Log: debug/info/warn/error
LOG_LEVEL=info
